# Copia este archivo como `.env` y complétalo SOLO en tu máquina.
# Nunca subas `.env` al repositorio ni compartas la contraseña por chat.

# --- Backend de grafo ------------------------------------------------------
# `jsonl` (por defecto) trabaja con los exports locales y no necesita Aura.
KNOWLEDGE_NEXUS_GRAPH_BACKEND=jsonl

# --- Embeddings ------------------------------------------------------------
KNOWLEDGE_NEXUS_EMBEDDING_PROVIDER=sentence-transformers
KNOWLEDGE_NEXUS_EMBEDDING_MODEL=BAAI/bge-m3
KNOWLEDGE_NEXUS_EMBEDDING_DIMENSION=1024
KNOWLEDGE_NEXUS_EMBEDDING_DEVICE=auto
KNOWLEDGE_NEXUS_EMBEDDING_BATCH_SIZE=32

# --- Conexión a Neo4j Aura (solo si GRAPH_BACKEND=neo4j) --------------------
# Las gestiona la capa de datos; el motor nunca las lee ni las registra.
NEO4J_URI=neo4j+s://<host>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- API -------------------------------------------------------------------
KNOWLEDGE_NEXUS_CORS_ORIGINS=*
